{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
	"entry": ["src/index.{ts,tsx,js,jsx}", "src/main.{ts,tsx,js,jsx}"],
	"ignorePatterns": [".storybook/**", "scripts/**"],
	"ignoreExports": [
		{
			"file": "src/lib/server/trusted-origins.ts",
			"exports": ["trustedOrigins", "resolveTrustedBase"]
		}
	],
	"ignoreDependencies": [
		"@tailwindcss/forms",
		"@tailwindcss/typography",
		"@openapitools/openapi-generator-cli"
	],
	"rules": {
		"unused-dependencies": "warn"
	},
	"audit": {
		"deadCodeBaseline": "fallow-baselines/dead-code@0709179.json",
		"healthBaseline": "fallow-baselines/health@0709179.json",
		"dupesBaseline": "fallow-baselines/dupes@0709179.json"
	}
}
