{
	"$schema": "./node_modules/@openapitools/openapi-generator-cli/config.schema.json",
	"spaces": 2,
	"generator-cli": {
		"version": "7.27.0",
		"generators": {
			"frontend-client": {
				"generatorName": "typescript-fetch",
				"inputSpec": "../backend/openapi.yaml",
				"output": "src/lib/api/generated",
				"additionalProperties": {
					"supportsES6": true
				}
			}
		}
	}
}
